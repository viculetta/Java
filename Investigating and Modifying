import org.code.neighborhood.*;

public class PainterPlus extends Painter {

  // Paints a square
  public void paintSquare(String color) {
    move();
    paint("blue");
    turnLeft();
    turnLeft();
    turnLeft();

    move();
    paint("blue");
    turnLeft();
    turnLeft();
    turnLeft();

    move();
    paint("blue");
    turnLeft();
    turnLeft();
    turnLeft();

    move();
    paint("blue");
    turnLeft();
    turnLeft();
    turnLeft();
  }
  
}

