import org.code.neighborhood.*;

public class PainterPlus extends Painter {

  // Paints a square
  public void paintSquare(String color) {
    move();
    paint(color);
    turnLeft();
    turnLeft();
    turnLeft();

    move();
    paint(color);
    turnLeft();
    turnLeft();
    turnLeft();

    move();
    paint(color);
    turnLeft();
    turnLeft();
    turnLeft();

    move();
    paint(color);
    turnLeft();
    turnLeft();
    turnLeft();
  }
  
}
