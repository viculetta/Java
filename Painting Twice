import org.code.neighborhood.*;
  public class PainterPlus extends Painter{
    public void turnRight() {
      this.turnLeft();
      this.turnLeft();
      this.turnLeft();
    }

    public void takePaintTwice() {
      this.takePaint();
      this.takePaint();
    }

    public void moveFast() {
      this.move();
      this.move();
      this.move();
    }

    public void paintTwice(String color) {
      this.paint(color);
      this.move();
      this.paint(color);
    }
}
