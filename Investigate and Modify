import org.code.neighborhood.*;

public class NeighborhoodRunner {
  public static void main(String[] args) {

    PainterPlus olivia = new PainterPlus();

    olivia.move();

    olivia.takePaint();
    olivia.takePaint();
    olivia.takePaint();
    olivia.takePaint();

    olivia.paintSquare("orange");
    
  }
}

