public class ScopeExample{
  public static void main(String[] args){
  
  int[] myArray = {1, 2, 3, 4};
  int sum = 0;
  for(int i = 0; i < myArray.length; i++){
  //if the int variable sum was declared in here, when running the code, we would receive an error message since the variable 'sum' was being used outside of its scope
    sum += myArray[i];
  }

  System.out.println(sum);
  }
}
