class Coffee {
  
  public static void main(String[] args) {
    
    // initialize cupsOfCoffee
    int cupsOfCoffee = 1;
    // add while loop with counter
    while (cupsOfCoffee <= 100) {
      System.out.println("\nFry drinks cup of coffee #" + cupsOfCoffee);
      cupsOfCoffee ++;
    }
        
    
  }
  
}
